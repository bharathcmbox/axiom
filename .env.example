# Copy to .env to override defaults.
AXIOM_DATABASE_URL=postgresql://axiom:axiom@127.0.0.1:5432/axiom
AXIOM_TEST_DATABASE_URL=postgresql://axiom:axiom@127.0.0.1:5432/axiom_test

# Workers (never commit real values; keep this file chmod 600 as .env)
AXIOM_GITHUB_TOKEN=          # fine-grained: one repo; Contents + Pull requests read/write, Actions read
AXIOM_MODEL_PROXY_ADMIN_TOKEN=   # `make worker-tokens` generates it; lets workers open runs on the proxy
ANTHROPIC_API_KEY=           # a dedicated key with a spend limit is recommended
# Added by `make worker-tokens`: AXIOM_DEV01_TOKEN, AXIOM_DEV02_TOKEN, AXIOM_REV01_TOKEN, AXIOM_SEC01_TOKEN
